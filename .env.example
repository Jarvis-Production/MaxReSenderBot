# Номер телефона аккаунта MAX в формате +79990000000
MAX_PHONE=
# ID группы MAX, из которой пересылать. Пусто = бот ничего не пересылает, только выводит список чатов
MAX_CHAT_ID=
# Токен бота Telegram от @BotFather
TG_TOKEN=
# ID группы-форума Telegram (вида -100xxxxxxxxxx)
TG_CHAT_ID=
# ID темы в форуме (число в конце ссылки на тему: t.me/c/xxxx/<ID>)
TG_THREAD_ID=
# Только для хостинга: вход в MAX без SMS-кода (значения из локального session/session.db)
MAX_TOKEN=
MAX_DEVICE_ID=
MAX_MT_INSTANCE_ID=
# Папка для файла сессии (на хостинге — постоянная папка, например /app/data)
DATA_DIR=
